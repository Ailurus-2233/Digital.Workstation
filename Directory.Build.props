<Project>
    <Import Project="$(MSBuildThisFileDirectory)Build\Base.props"
            Condition=" '$(MSBuildProjectDirectory)' != '' "/>
    <Import Project="$(MSBuildThisFileDirectory)Build\ManageDlls.props"
            Condition=" '$(MSBuildProjectDirectory)' != '' and !$(MSBuildProjectDirectory.Contains('\UnitTest\')) "/>
</Project>
