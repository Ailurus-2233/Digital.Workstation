<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="using:DigitalWorkstation.MailReader.Resources" x:Class="DigitalWorkstation.MailReader.MailAccountView">
    <StackPanel Margin="0,6" Spacing="6">
        <TextBlock Text="{x:Static r:MailResources.Password}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Name="LoginCode" PasswordChar="●" IsUndoEnabled="False"
                     AutomationProperties.Name="{x:Static r:MailResources.Password}" />
            <Button Grid.Column="1" Name="AuthenticateButton" Content="{x:Static r:MailResources.Authenticate}" Click="Authenticate" />
        </Grid>
        <CheckBox Name="RememberCode" IsChecked="False" Content="{x:Static r:MailResources.RememberLoginCode}" />
        <TextBlock Name="Feedback" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
