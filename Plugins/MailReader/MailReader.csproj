<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Abstractions\Abstractions.csproj" />
        <ProjectReference Include="..\..\Core\Framework\Framework.csproj" />
        <ProjectReference Include="..\..\Core\Resource\Resource.csproj" />
        <ProjectReference Include="..\..\Core\UIPackage\UIPackage.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MailKit" Version="4.18.1" />
        <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="MailReader.DataFlowTests" />
    </ItemGroup>
    <!-- Sample was replaced, so an incremental build must not rediscover its stale entry DLL. -->
    <Target Name="RemoveRetiredSampleEntry" BeforeTargets="Build">
        <ItemGroup>
            <RetiredSample Include="$(BaseOutputPath)DigitalWorkstation.Sample.dll;$(BaseOutputPath)DigitalWorkstation.Sample.pdb;$(BaseOutputPath)DigitalWorkstation.Sample.deps.json;$(BaseOutputPath)en-US/DigitalWorkstation.Sample.resources.dll;$(BaseOutputPath)plugins/Sample/DigitalWorkstation.Sample.dll;$(BaseOutputPath)plugins/Sample/DigitalWorkstation.Sample.deps.json;$(BaseOutputPath)plugins/Sample/en-US/DigitalWorkstation.Sample.resources.dll" />
        </ItemGroup>
        <Delete Files="@(RetiredSample)" />
    </Target>
</Project>
