<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="using:DigitalWorkstation.MailReader.Resources" x:Class="DigitalWorkstation.MailReader.MailListView">
    <Grid RowDefinitions="Auto,3,*" RowSpacing="6" Margin="8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock FontSize="18" VerticalAlignment="Center" Text="{x:Static r:MailResources.MessageList}" />
            <Button Grid.Column="1" Padding="6" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"
                    ToolTip.Tip="{x:Static r:MailResources.Refresh}" AutomationProperties.Name="{x:Static r:MailResources.Refresh}">
                <PathIcon Width="16" Height="16" Data="M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 7.93 9h-2.02A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4Z" />
            </Button>
        </Grid>
        <Border Grid.Row="1" Height="1" VerticalAlignment="Center" Background="{DynamicResource SemiColorBorder}"
                IsVisible="{Binding !IsBusy}" />
        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="{Binding InboxFeedback}" IsVisible="{Binding ShowInboxWarning}" />
            <Grid>
                <TextBlock VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding InboxFeedback}" IsVisible="{Binding !HasMessages}" />
                <ListBox IsVisible="{Binding HasMessages}" ItemsSource="{Binding Messages}"
                         SelectedItem="{Binding SelectedMessage, Mode=TwoWay}" Tapped="OnMessageTapped"
                         KeyDown="OnMessageKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="3" Margin="0,4">
                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding From}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DisplayDate}" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
