<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="using:DigitalWorkstation.MailReader.Resources" xmlns:mail="using:DigitalWorkstation.MailReader"
             x:Class="DigitalWorkstation.MailReader.MailReadingView">
    <ScrollViewer Margin="16" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8">
            <SelectableTextBlock Text="{Binding Subject}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static r:MailResources.From}" />
            <SelectableTextBlock Text="{Binding From}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static r:MailResources.To}" />
            <SelectableTextBlock Text="{Binding To}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static r:MailResources.Date}" />
            <SelectableTextBlock Text="{Binding DisplayDate}" />
            <mail:MailContentView Message="{Binding}" Margin="0,8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
