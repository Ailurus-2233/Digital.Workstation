<UserControl
    x:Class="DigitalWorkstation.Settings.Views.SettingsPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="using:DigitalWorkstation.Settings.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <!--  设置页：左侧设置分组树、右侧选中分组的设置项编辑器（ADR-0006 决策 5/8）  -->
    <UserControl.DataTemplates>
        <!--  枚举设置项：名称 + 下拉框（成员显示名已本地化）  -->
        <DataTemplate DataType="viewmodels:EnumSettingItemModel">
            <Grid Margin="0,6" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                <ComboBox
                    Grid.Column="1"
                    MinWidth="220"
                    ItemsSource="{Binding Options}"
                    SelectedItem="{Binding SelectedOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="240,*" Margin="12">
        <Border
            Background="{DynamicResource SemiColorBackground1}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1"
            CornerRadius="8">
            <ListBox
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Groups}"
                SelectedItem="{Binding SelectedGroup}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <ScrollViewer Grid.Column="1" Margin="12,0,0,0">
            <ItemsControl ItemsSource="{Binding Items}" />
        </ScrollViewer>
    </Grid>
</UserControl>
