<UserControl
    x:Class="DigitalWorkstation.Settings.Views.SettingsPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:views="using:DigitalWorkstation.Settings.Views"
    xmlns:layout="using:DigitalWorkstation.Core.Framework.Layout"
    layout:TabEditing.Editor="{Binding}"
    IsEnabled="{Binding !SaveCommand.IsRunning}"
    xmlns:resource="using:DigitalWorkstation.Settings.Resources"
    xmlns:viewmodels="using:DigitalWorkstation.Settings.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <!--  设置页：左侧设置分组树、右侧选中分组的设置项编辑器  -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="viewmodels:ProxySettingItemModel">
            <StackPanel Margin="0,6" Spacing="16">
                <CheckBox IsChecked="{Binding Enabled}">
                    <views:DraftLabel Label="{x:Static resource:SettingsResources.ProxyEnabled}" HasDraft="{Binding EnabledModified}" />
                </CheckBox>
                <StackPanel Spacing="4">
                    <views:DraftLabel Label="{x:Static resource:SettingsResources.ProxyAddress}" HasDraft="{Binding AddressModified}" />
                    <TextBox Text="{Binding Address}" Watermark="http://127.0.0.1:7890" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                        <views:DraftLabel Label="{x:Static resource:SettingsResources.ProxyUsername}" HasDraft="{Binding UsernameModified}" TextWrapping="Wrap" />
                        <TextBox Grid.Row="1" Text="{Binding Username}" />
                        <views:DraftLabel Grid.Column="1" Label="{x:Static resource:SettingsResources.ProxyPassword}" HasDraft="{Binding PasswordModified}" TextWrapping="Wrap" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Password}" PasswordChar="●" />
                    </Grid>
                    <TextBlock Text="{x:Static resource:SettingsResources.ProxyPasswordHint}" TextWrapping="Wrap"
                               FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{x:Static resource:SettingsResources.ProxyTestTarget}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding TestTarget, Mode=TwoWay}" />
                        <Button Grid.Column="1" Command="{Binding TestConnectionCommand}" Content="{x:Static resource:SettingsResources.ProxyTestButton}" />
                    </Grid>
                    <TextBlock IsVisible="{Binding !!TestStatus.Length}" Text="{Binding TestStatus}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <views:DraftLabel FontWeight="SemiBold" Label="{x:Static resource:SettingsResources.ProxyModules}" HasDraft="{Binding ModulesModified}" />
                    <DataGrid ItemsSource="{Binding Modules}" IsVisible="{Binding HasModules}" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserResizeColumns="False" CanUserReorderColumns="False"
                              CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static resource:SettingsResources.ProxyModuleName}"
                                                Width="9*" Binding="{Binding Module.DisplayName}" />
                            <DataGridTemplateColumn Header="{x:Static resource:SettingsResources.ProxyModuleEnabled}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Module.DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock IsVisible="{Binding !HasModules}" Text="{x:Static resource:SettingsResources.ProxyModulesEmpty}"
                               TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="viewmodels:StringSettingItemModel">
            <StackPanel Margin="0,6" Spacing="6">
                <views:DraftLabel Label="{Binding Name}" HasDraft="{Binding HasDraft}" />
                <TextBox Text="{Binding Value, Mode=TwoWay}" />
                <TextBlock Text="{Binding RestartPendingMarkText}" IsVisible="{Binding ShowRestartPending}" />
            </StackPanel>
        </DataTemplate>
        <!--  枚举设置项：名称 + 「重启后生效」项级标记 + 下拉框（成员显示名已本地化）  -->
        <DataTemplate DataType="viewmodels:EnumSettingItemModel">
            <Grid Margin="0,6" ColumnDefinitions="*,Auto,Auto">
                <views:DraftLabel VerticalAlignment="Center" Label="{Binding Name}" HasDraft="{Binding HasDraft}" />
                <Border
                    Grid.Column="1"
                    Margin="8,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsVisible="{Binding ShowRestartPending}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource SemiColorText2}"
                        Text="{Binding RestartPendingMarkText}" />
                </Border>
                <ComboBox
                    Grid.Column="2"
                    MinWidth="220"
                    ItemsSource="{Binding Options}"
                    SelectedItem="{Binding SelectedOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid Margin="12">
        <TabControl IsEnabled="{Binding !SaveCommand.IsRunning}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem>
                <TabItem.Header>
                    <views:DraftLabel Label="{x:Static resource:SettingsResources.GeneralSettingsTabTitle}" HasDraft="{Binding HasSettingsDraft}" />
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                    <!--  需重启修改横幅：存在未生效的需重启修改时显示，「立即重启」启动新进程并退出当前进程  -->
                    <Border
                        Margin="0,0,0,12"
                        Padding="12,8"
                        Background="{DynamicResource SemiColorBackground1}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsVisible="{Binding HasPendingRestartChanges}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock VerticalAlignment="Center" Text="{Binding RestartBannerText}" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding RestartNowCommand}"
                                Content="{Binding RestartNowButtonTitle}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="240,*">
                        <Border
                            Background="{DynamicResource SemiColorBackground1}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ListBox
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding Groups}"
                                SelectedItem="{Binding SelectedGroup}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <views:DraftLabel Label="{Binding Name}" HasDraft="{Binding HasDraft}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <ScrollViewer Grid.Column="1" Margin="12,0,0,0">
                            <StackPanel Margin="0,0,0,64">
                                <ItemsControl ItemsSource="{Binding SelectedGroup.Items}" />
                                <ContentControl DataContext="{Binding SelectedGroup}" Content="{Binding Panel}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <views:DraftLabel Label="{x:Static resource:SettingsResources.PluginsTitle}" HasDraft="{Binding PluginsPage.HasDraft}" />
                </TabItem.Header>
                <views:PluginsPageView DataContext="{Binding PluginsPage}" />
            </TabItem>
        </TabControl>
        <Border Margin="12" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="{DynamicResource SemiColorBackground1}" CornerRadius="10" BoxShadow="0 2 8 0 #40000000">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Margin="8,0,12,0" VerticalAlignment="Center" IsVisible="{Binding !!SaveStatus.Length}"
                           Text="{Binding SaveStatus}" TextWrapping="Wrap" />
                <Button Grid.Column="1" MinWidth="72" HorizontalContentAlignment="Center" Classes="Primary"
                        Command="{Binding SaveCommand}" Content="{x:Static resource:SettingsResources.SettingsSave}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

