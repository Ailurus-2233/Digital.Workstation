<UserControl
    x:Class="DigitalWorkstation.Settings.Views.SettingsPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:views="using:DigitalWorkstation.Settings.Views"
    xmlns:resource="using:DigitalWorkstation.Settings.Resources"
    xmlns:viewmodels="using:DigitalWorkstation.Settings.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <!--  设置页：左侧设置分组树、右侧选中分组的设置项编辑器  -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="viewmodels:ProxySettingItemModel">
            <StackPanel Margin="0,6" Spacing="16" IsEnabled="{Binding !SaveCommand.IsRunning}">
                <CheckBox Content="{x:Static resource:SettingsResources.ProxyEnabled}" IsChecked="{Binding Enabled}" />
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Static resource:SettingsResources.ProxyAddress}" />
                    <TextBox Text="{Binding Address}" Watermark="http://127.0.0.1:7890" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                        <TextBlock Text="{x:Static resource:SettingsResources.ProxyUsername}" TextWrapping="Wrap" />
                        <TextBox Grid.Row="1" Text="{Binding Username}" />
                        <TextBlock Grid.Column="1" Text="{x:Static resource:SettingsResources.ProxyPassword}" TextWrapping="Wrap" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Password}" PasswordChar="●" />
                    </Grid>
                    <TextBlock Text="{x:Static resource:SettingsResources.ProxyPasswordHint}" TextWrapping="Wrap"
                               FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{x:Static resource:SettingsResources.ProxyTestTarget}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding TestTarget, Mode=TwoWay}" />
                        <Button Grid.Column="1" Command="{Binding TestConnectionCommand}" Content="{x:Static resource:SettingsResources.ProxyTestButton}" />
                    </Grid>
                    <TextBlock IsVisible="{Binding !!TestStatus.Length}" Text="{Binding TestStatus}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{x:Static resource:SettingsResources.ProxyModules}" />
                    <DataGrid ItemsSource="{Binding Modules}" IsVisible="{Binding HasModules}" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserResizeColumns="False" CanUserReorderColumns="False"
                              CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static resource:SettingsResources.ProxyModuleName}"
                                                Width="9*" Binding="{Binding Module.DisplayName}" />
                            <DataGridTemplateColumn Header="{x:Static resource:SettingsResources.ProxyModuleEnabled}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Module.DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock IsVisible="{Binding !HasModules}" Text="{x:Static resource:SettingsResources.ProxyModulesEmpty}"
                               TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="viewmodels:StringSettingItemModel">
            <StackPanel Margin="0,6" Spacing="6">
                <TextBlock Text="{Binding Name}" />
                <TextBox Text="{Binding Value, Mode=TwoWay}" />
                <TextBlock Text="{Binding RestartPendingMarkText}" IsVisible="{Binding ShowRestartPending}" />
            </StackPanel>
        </DataTemplate>
        <!--  枚举设置项：名称 + 「重启后生效」项级标记 + 下拉框（成员显示名已本地化）  -->
        <DataTemplate DataType="viewmodels:EnumSettingItemModel">
            <Grid Margin="0,6" ColumnDefinitions="*,Auto,Auto">
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                <Border
                    Grid.Column="1"
                    Margin="8,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsVisible="{Binding ShowRestartPending}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource SemiColorText2}"
                        Text="{Binding RestartPendingMarkText}" />
                </Border>
                <ComboBox
                    Grid.Column="2"
                    MinWidth="220"
                    ItemsSource="{Binding Options}"
                    SelectedItem="{Binding SelectedOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <TabControl Margin="12">
        <TabItem Header="{x:Static resource:SettingsResources.GeneralSettingsTabTitle}">
            <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                <!--  需重启修改横幅：存在未生效的需重启修改时显示，「立即重启」启动新进程并退出当前进程  -->
                <Border
                    Margin="0,0,0,12"
                    Padding="12,8"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsVisible="{Binding HasPendingRestartChanges}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock VerticalAlignment="Center" Text="{Binding RestartBannerText}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding RestartNowCommand}"
                            Content="{Binding RestartNowButtonTitle}" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="240,*">
                    <Border
                        Background="{DynamicResource SemiColorBackground1}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Groups}"
                            SelectedItem="{Binding SelectedGroup}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <Grid Grid.Column="1" Margin="12,0,0,0" RowDefinitions="*,Auto">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Items}" />
                        </ScrollViewer>
                        <Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="12"
                              DataContext="{Binding ProxyEditor}" IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding SaveCommand}" Content="{x:Static resource:SettingsResources.ProxySave}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
                </TabItem>
        <TabItem Header="{x:Static resource:SettingsResources.PluginsTitle}">
            <views:PluginsPageView />
        </TabItem>
    </TabControl>
</UserControl>
