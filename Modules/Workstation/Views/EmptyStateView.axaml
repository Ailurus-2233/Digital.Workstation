<UserControl
    x:Class="DigitalWorkstation.Workstation.Views.EmptyStateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    xmlns:vm="clr-namespace:DigitalWorkstation.Workstation.ViewModels"
    xmlns:localResource="clr-namespace:DigitalWorkstation.Workstation.Resources"
    xmlns:resource="clr-namespace:DigitalWorkstation.Core.Resource;assembly=DigitalWorkstation.Core.Resource">
    <UserControl.Resources>
        <DataTemplate x:Key="LoadedComponentTemplate" x:DataType="vm:LoadedComponentItem">
            <Border Background="Transparent" Padding="0,3" ToolTip.Tip="{Binding Description}">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.module-card">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="32" MaxWidth="840" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,24,2*" Margin="0,16,0,36">
                <Image Width="112" Height="112" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Source="avares://DigitalWorkstation.Workstation/Assets/AppIcon.png" />
                <StackPanel Grid.Column="2" Spacing="14" MaxWidth="520"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static resource:SharedResources.ProductName}" FontSize="28" FontWeight="SemiBold"
                               TextAlignment="Left" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static localResource:WorkstationResources.HomeDescription}"
                               Foreground="{DynamicResource SemiColorText2}" TextAlignment="Left" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
                <TextBlock Classes="section-title" Text="{x:Static localResource:WorkstationResources.HomeLoadedModulesTitle}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Classes="section-title" Text="{x:Static localResource:WorkstationResources.HomeLoadedPluginsTitle}" TextWrapping="Wrap" />
                <Border Grid.Row="1" Classes="module-card">
                    <TreeView x:Name="ModuleTree" ItemTemplate="{StaticResource LoadedComponentTemplate}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Resources>
                            <x:Double x:Key="TreeViewItemIndent">12</x:Double>
                        </TreeView.Resources>
                            <TreeViewItem x:Name="CoreModules" ItemsSource="{Binding CoreModules}" IsExpanded="True">
                                <TreeViewItem.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static localResource:WorkstationResources.HomeCoreTitle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="CoreEmpty" IsVisible="{Binding IsCoreEmpty}" Text="{x:Static localResource:WorkstationResources.HomeNoModules}"
                                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="CustomModules" ItemsSource="{Binding CustomModules}" IsExpanded="True">
                                <TreeViewItem.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static localResource:WorkstationResources.HomeCustomTitle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="CustomEmpty" IsVisible="{Binding IsCustomEmpty}" Text="{x:Static localResource:WorkstationResources.HomeNoModules}"
                                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                    </TreeView>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Classes="module-card">
                    <StackPanel>
                        <TextBlock IsVisible="{Binding IsPluginsEmpty}"
                                   Text="{x:Static localResource:WorkstationResources.HomeNoPlugins}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}" />
                        <ItemsControl ItemsSource="{Binding LoadedPlugins}"
                                      ItemTemplate="{StaticResource LoadedComponentTemplate}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
