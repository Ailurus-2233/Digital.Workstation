<UserControl
    x:Class="DigitalWorkstation.Workstation.Views.EmptyStateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resource="clr-namespace:DigitalWorkstation.Core.Resource;assembly=DigitalWorkstation.Core.Resource">
    <UserControl.Styles>
        <Style Selector="Border.module-card">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style Selector="TextBlock.module-name">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="32" MaxWidth="840" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch">
            <StackPanel Spacing="14" Margin="0,16,0,36" HorizontalAlignment="Center">
                <Image Width="112" Height="112" Source="avares://DigitalWorkstation.Workstation/Assets/AppIcon.png" />
                <TextBlock Text="{x:Static resource:Language.ProductName}" FontSize="28" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static resource:Language.HomeDescription}" MaxWidth="520"
                           Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,16,*">
                <Border Classes="module-card">
                    <StackPanel>
                        <TextBlock Classes="section-title" Text="{x:Static resource:Language.HomeCoreTitle}" />
                        <ItemsControl x:Name="CoreList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Classes="module-name" Text="{Binding}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="CoreEmpty" Text="{x:Static resource:Language.HomeNoModules}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="module-card">
                    <StackPanel>
                        <TextBlock Classes="section-title" Text="{x:Static resource:Language.HomeCustomTitle}" />
                        <ItemsControl x:Name="CustomList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Classes="module-name" Text="{Binding}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="CustomEmpty" Text="{x:Static resource:Language.HomeNoModules}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
