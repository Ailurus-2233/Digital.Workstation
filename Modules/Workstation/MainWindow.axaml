<win:FrameworkWindow
    Height="800"
    MinHeight="600"
    MinWidth="960"
    Padding="0,32,0,0"
    Title="Digital.Workstation"
    Width="1280"
    d:DesignHeight="800"
    d:DesignWidth="1280"
    mc:Ignorable="d"
    PanelAlignment="{Binding PanelAlignment, Mode=TwoWay}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    x:Class="DigitalWorkstation.Workstation.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:win="clr-namespace:DigitalWorkstation.Core.Framework.Windows;assembly=DigitalWorkstation.Core.Framework"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  基础布局（五区布局 + 状态栏）与菜单栏由 FrameworkWindow 提供，见 Core/Framework/Windows/FrameworkWindowTheme.axaml；
          本文件只保留应用级 chrome：窗口标题、快捷键  -->

    <win:FrameworkWindow.Styles>
        <!--  标题栏底色：与窗口背景（面板容器/ActivityBar）同色，视觉融为一体  -->
        <Style Selector="u|TitleBar">
            <Setter Property="Background" Value="{DynamicResource SemiColorNavBackground}" />
        </Style>
    </win:FrameworkWindow.Styles>

    <win:FrameworkWindow.KeyBindings>
        <KeyBinding Command="{Binding ToggleSideBarCommand}" Gesture="Ctrl+B" />
        <KeyBinding Command="{Binding ToggleBottomPanelCommand}" Gesture="Ctrl+J" />
        <KeyBinding Command="{Binding ToggleAuxiliaryPanelCommand}" Gesture="Ctrl+Alt+B" />
    </win:FrameworkWindow.KeyBindings>

    <win:FrameworkWindow.TitleBarContent>
        <TextBlock
            FontSize="12"
            Foreground="{DynamicResource SemiColorText2}"
            HorizontalAlignment="Center"
            IsHitTestVisible="False"
            Text="{Binding $parent[u:UrsaWindow].Title}"
            VerticalAlignment="Center" />
    </win:FrameworkWindow.TitleBarContent>
</win:FrameworkWindow>
