<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DigitalWorkstation.NotifyPanel" xmlns:ui="using:DigitalWorkstation.Core.UIPackage"
             x:Class="DigitalWorkstation.NotifyPanel.NotifyPanelView">
    <Grid Margin="8">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="{x:Static local:NotifyResources.Empty}" IsVisible="{Binding !Messages.Count}" />
        <ListBox ItemsSource="{Binding Messages}" IsVisible="{Binding !!Messages.Count}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,3,40,3">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Text="{Binding Level, Converter={x:Static local:NotifyResources.LevelLabel}}" />
                                <TextBlock FontSize="11" Text="{Binding CreatedAt, StringFormat='{}{0:t}'}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Padding="4"
                                ToolTip.Tip="{x:Static local:NotifyResources.Remove}"
                                AutomationProperties.Name="{x:Static local:NotifyResources.Remove}"
                                Command="{Binding $parent[ListBox].DataContext.RemoveCommand}" CommandParameter="{Binding}">
                            <PathIcon Width="12" Height="12" Data="{x:Static ui:Icons.Exit}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,12,0" ZIndex="1"
                Background="{DynamicResource SemiColorBackground2}" CornerRadius="16" BoxShadow="0 2 6 0 #50000000">
            <Button Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="16"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    AutomationProperties.Name="{x:Static local:NotifyResources.ClearAll}"
                    Command="{Binding ClearCommand}" IsEnabled="{Binding !!Messages.Count}">
                <PathIcon Width="17" Height="17" Data="{x:Static ui:Icons.Broom}" RenderTransform="rotate(32deg)" />
            </Button>
        </Border>
    </Grid>
</UserControl>
